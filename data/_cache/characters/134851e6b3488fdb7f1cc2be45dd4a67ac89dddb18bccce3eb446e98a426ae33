\\n\\n            <div class=\\\"ne-title\\\">\\n                $1\\n            </div>\\n\\n            <div class=\\\"ne-whisper\\\">\\n                𝜗𝜚⊹₊ഒﾟ*\\n            </div>\\n\\n        </div>\\n\\n\\n        <!-- =================================================\\n             歌名\\n             ================================================= -->\\n\\n        <div class=\\\"ne-song-wrap\\\">\\n\\n            <span class=\\\"ne-song-mark\\\">\\n                𝒜\\n            </span>\\n\\n            <div class=\\\"ne-song\\\">\\n                $2\\n            </div>\\n\\n            <span class=\\\"ne-song-mark\\\">\\n                𝒜\\n            </span>\\n\\n        </div>\\n\\n\\n        <!-- =================================================\\n             播放控制\\n             ================================================= -->\\n\\n        <div class=\\\"ne-controls\\\">\\n\\n            <span class=\\\"ne-time ne-current\\\">\\n                00:00\\n            </span>\\n\\n\\n            <div class=\\\"ne-progress\\\">\\n\\n                <div class=\\\"ne-progress-track\\\"></div>\\n\\n                <div class=\\\"ne-progress-fill\\\"></div>\\n\\n                <div class=\\\"ne-progress-dot\\\"></div>\\n\\n            </div>\\n\\n\\n            <span class=\\\"ne-time ne-duration\\\">\\n                00:00\\n            </span>\\n\\n\\n            <button\\n                class=\\\"ne-play\\\"\\n                type=\\\"button\\\"\\n                aria-label=\\\"播放\\\">\\n\\n                <span class=\\\"ne-play-icon\\\">\\n                    ▶\\n                </span>\\n\\n            </button>\\n\\n        </div>\\n\\n\\n        <!-- =================================================\\n             音频\\n             ================================================= -->\\n\\n        <audio\\n            class=\\\"ne-audio\\\"\\n            preload=\\\"auto\\\"\\n            loop>\\n\\n            <source\\n                src=\\\"$3\\\"\\n                type=\\\"audio/mpeg\\\">\\n\\n        </audio>\\n\\n    </div>\\n\\n</div>\\n\\n\\n<script>\\n(function(){\\n\\n    var wraps=document.querySelectorAll(\\n        '.ne-player-wrap:not([data-ne-init])'\\n    );\\n\\n    if(!wraps.length){\\n        return;\\n    }\\n\\n\\n    Array.prototype.forEach.call(\\n        wraps,\\n        function(wrap){\\n\\n            wrap.setAttribute(\\n                'data-ne-init',\\n                '1'\\n            );\\n\\n\\n            var player=\\n                wrap.querySelector('.ne-player');\\n\\n            var titleEl=\\n                wrap.querySelector('.ne-title');\\n\\n            var audio=\\n                wrap.querySelector('.ne-audio');\\n\\n            var playBtn=\\n                wrap.querySelector('.ne-play');\\n\\n            var playIcon=\\n                wrap.querySelector('.ne-play-icon');\\n\\n            var progress=\\n                wrap.querySelector('.ne-progress');\\n\\n            var fill=\\n                wrap.querySelector('.ne-progress-fill');\\n\\n            var dot=\\n                wrap.querySelector('.ne-progress-dot');\\n\\n            var currentTime=\\n                wrap.querySelector('.ne-current');\\n\\n            var duration=\\n                wrap.querySelector('.ne-duration');\\n\\n            var modeBtn=\\n                wrap.querySelector('.ne-mode');\\n\\n\\n            /* =================================================\\n               标题处理\\n               8字不换行\\n               第9字开始换行\\n               每行最多8字\\n               且避免最后单独剩1个字\\n               ================================================= */\\n\\n            function setupTitle(){\\n\\n                if(!titleEl){\\n                    return;\\n                }\\n\\n\\n                var original=\\n                    titleEl.textContent\\n                    .replace(/\\\\s+/g,'')\\n                    .trim();\\n\\n\\n                if(!original){\\n                    return;\\n                }\\n\\n\\n                /* 8字及以内：保持单行 */\\n                if(original.length<=8){\\n                    return;\\n                }\\n\\n\\n                titleEl.classList.add(\\n                    'ne-title-long'\\n                );\\n\\n                player.classList.add(\\n                    'ne-long-title'\\n                );\\n\\n\\n                var total=\\n                    original.length;\\n\\n\\n                /*\\n                 * 每行最多8字。\\n                 * 先计算需要几行，再把文字尽量平均分配，\\n                 * 避免出现最后一行只有1个字。\\n                 *\\n                 * 例如：\\n                 * 9  -> 5 + 4\\n                 * 10 -> 5 + 5\\n                 * 17 -> 6 + 6 + 5\\n                 * 18 -> 6 + 6 + 6\\n                 */\\n                var lineCount=\\n                    Math.ceil(total/8);\\n\\n                var base=\\n                    Math.floor(total/lineCount);\\n\\n                var remainder=\\n                    total%lineCount;\\n\\n                var chunks=[];\\n                var start=0;\\n\\n\\n                for(\\n                    var i=0;\\n                    i<lineCount;\\n                    i++\\n                ){\\n\\n                    /*\\n                     * 前面的行多分一个字，\\n                     * 剩余部分自动均匀分配。\\n                     */\\n                    var lineLength=\\n                        base+\\n                        (i<remainder?1:0);\\n\\n\\n                    chunks.push(\\n                        original.slice(\\n                            start,\\n                            start+lineLength\\n                        )\\n                    );\\n\\n\\n                    start+=lineLength;\\n\\n                }\\n\\n\\n                titleEl.innerHTML=\\n                    chunks.join('<br>');\\n\\n            }\\n\\n\\n            setupTitle();\\n\\n\\n            /* =================================================\\n               昼夜\\n               ================================================= */\\n\\n            modeBtn.addEventListener(\\n                'click',\\n                function(e){\\n\\n                    e.stopPropagation();\\n\\n\\n                    var isNight=\\n                        wrap.classList.toggle(\\n                            'ne-night'\\n                        );\\n\\n\\n                    if(isNight){\\n\\n                        modeBtn.textContent=\\n                            'DAY';\\n\\n                        modeBtn.setAttribute(\\n                            'aria-label',\\n                            '切换日间模式'\\n                        );\\n\\n                    }else{\\n\\n                        modeBtn.textContent=\\n                            'NIGHT';\\n\\n                        modeBtn.setAttribute(\\n                            'aria-label',\\n                            '切换夜间模式'\\n                        );\\n\\n                    }\\n\\n                }\\n            );\\n\\n\\n            /* =================================================\\n               时间\\n               ================================================= */\\n\\n            function formatTime(sec){\\n\\n                if(\\n                    !isFinite(sec)||\\n                    sec<0\\n                ){\\n                    return '00:00';\\n                }\\n\\n\\n                var m=\\n                    Math.floor(sec/60);\\n\\n                var s=\\n                    Math.floor(sec%60);\\n\\n\\n                return String(m).padStart(2,'0')\\n                    +':'\\n                    +String(s).padStart(2,'0');\\n\\n            }\\n\\n\\n            /* =================================================\\n               播放状态\\n               ================================================= */\\n\\n            function setPlaying(state){\\n\\n                if(state){\\n\\n                    player.classList.add(\\n                        'is-playing'\\n                    );\\n\\n                    playIcon.textContent=\\n                        'Ⅱ';\\n\\n                    playBtn.setAttribute(\\n                        'aria-label',\\n                        '暂停'\\n                    );\\n\\n                }else{\\n\\n                    player.classList.remove(\\n                        'is-playing'\\n                    );\\n\\n                    playIcon.textContent=\\n                        '▶';\\n\\n                    playBtn.setAttribute(\\n                        'aria-label',\\n                        '播放'\\n                    );\\n\\n                }\\n\\n            }\\n\\n\\n            /* =================================================\\n               进度\\n               ================================================= */\\n\\n            function updateProgress(){\\n\\n                if(\\n                    !isFinite(audio.duration)||\\n                    audio.duration<=0\\n                ){\\n                    return;\\n                }\\n\\n\\n                var percent=\\n                    audio.currentTime/\\n                    audio.duration*\\n                    100;\\n\\n\\n                percent=Math.max(\\n                    0,\\n                    Math.min(\\n                        100,\\n                        percent\\n                    )\\n                );\\n\\n\\n                fill.style.width=\\n                    percent+'%';\\n\\n                dot.style.left=\\n                    percent+'%';\\n\\n\\n                currentTime.textContent=\\n                    formatTime(\\n                        audio.currentTime\\n                    );\\n\\n\\n                duration.textContent=\\n                    formatTime(\\n                        audio.duration\\n                    );\\n\\n            }\\n\\n\\n            /* =================================================\\n               播放 / 暂停\\n               ================================================= */\\n\\n            playBtn.addEventListener(\\n                'click',\\n                function(e){\\n\\n                    e.stopPropagation();\\n\\n\\n                    if(audio.paused){\\n\\n                        audio.play()\\n                        .then(function(){\\n\\n                            setPlaying(true);\\n\\n                        })\\n                        .catch(function(error){\\n\\n                            console.log(\\n                                '播放失败：',\\n                                error\\n                            );\\n\\n                        });\\n\\n                    }else{\\n\\n                        audio.pause();\\n\\n                    }\\n\\n                }\\n            );\\n\\n\\n            /* =================================================\\n               自动播放\\n               ================================================= */\\n\\n            function tryPlay(){\\n\\n                audio.play()\\n                .then(function(){\\n\\n                    setPlaying(true);\\n\\n                })\\n                .catch(function(){});\\n\\n            }\\n\\n\\n            setTimeout(\\n                function(){\\n\\n                    tryPlay();\\n\\n                },\\n                150\\n            );\\n\\n\\n            /* =================================================\\n               第一次用户操作解锁自动播放\\n               ================================================= */\\n\\n            function unlockPlay(){\\n\\n                if(!audio.paused){\\n                    return;\\n                }\\n\\n\\n                audio.play()\\n                .then(function(){\\n\\n                    setPlaying(true);\\n\\n\\n                    document.removeEventListener(\\n                        'touchstart',\\n                        unlockPlay,\\n                        true\\n                    );\\n\\n\\n                    document.removeEventListener(\\n                        'click',\\n                        unlockPlay,\\n                        true\\n                    );\\n\\n                })\\n                .catch(function(){});\\n\\n            }\\n\\n\\n            document.addEventListener(\\n                'touchstart',\\n                unlockPlay,\\n                {\\n                    once:true,\\n                    capture:true\\n                }\\n            );\\n\\n\\n            document.addEventListener(\\n                'click',\\n                unlockPlay,\\n                {\\n                    once:true,\\n                    capture:true\\n                }\\n            );\\n\\n\\n            /* =================================================\\n               点击进度\\n               ================================================= */\\n\\n            progress.addEventListener(\\n                'click',\\n                function(e){\\n\\n                    e.stopPropagation();\\n\\n\\n                    if(\\n                        !isFinite(audio.duration)||\\n                        audio.duration<=0\\n                    ){\\n                        return;\\n                    }\\n\\n\\n                    var rect=\\n                        progress.getBoundingClientRect();\\n\\n\\n                    var ratio=\\n                        (\\n                            e.clientX-\\n                            rect.left\\n                        )/\\n                        rect.width;\\n\\n\\n                    ratio=Math.max(\\n                        0,\\n                        Math.min(\\n                            1,\\n                            ratio\\n                        )\\n                    );\\n\\n\\n                    audio.currentTime=\\n                        audio.duration*\\n                        ratio;\\n\\n\\n                    updateProgress();\\n\\n                }\\n            );\\n\\n\\n            /* =================================================\\n               音频事件\\n               ================================================= */\\n\\n            audio.addEventListener(\\n                'loadedmetadata',\\n                function(){\\n\\n                    duration.textContent=\\n                        formatTime(\\n                            audio.duration\\n                        );\\n\\n                    updateProgress();\\n\\n                }\\n            );\\n\\n\\n            audio.addEventListener(\\n                'timeupdate',\\n                function(){\\n\\n                    updateProgress();\\n\\n                }\\n            );\\n\\n\\n            audio.addEventListener(\\n                'play',\\n                function(){\\n\\n                    setPlaying(true);\\n\\n                }\\n            );\\n\\n\\n            audio.addEventListener(\\n                'pause',\\n                function(){\\n\\n                    setPlaying(false);\\n\\n                }\\n            );\\n\\n\\n            audio.addEventListener(\\n                'ended',\\n                function(){\\n\\n                    audio.currentTime=0;\\n\\n                    updateProgress();\\n\\n\\n                    if(audio.loop){\\n\\n                        audio.play()\\n                        .then(function(){\\n\\n                            setPlaying(true);\\n\\n                        })\\n                        .catch(function(){\\n\\n                            setPlaying(false);\\n\\n                        });\\n\\n                    }else{\\n\\n                        setPlaying(false);\\n\\n                    }\\n\\n                }\\n            );\\n\\n        }\\n    );\\n\\n})();\\n</script>\\n\\n</body>\\n</html>\\n```\",\"trimStrings\":[],\"placement\":[1,2],\"disabled\":false,\"markdownOnly\":true,\"promptOnly\":false,\"runOnEdit\":true,\"substituteRegex\":0,\"minDepth\":null,\"maxDepth\":null},{\"id\":\