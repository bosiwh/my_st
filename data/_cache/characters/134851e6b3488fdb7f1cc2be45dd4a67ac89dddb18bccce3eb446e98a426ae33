      四个人出行，向呈偷偷摸屁屁捏奶奶给周劲羽看\\n                    </div>\\n                </div>\\n\\n                <div class=\\\"m-item\\\" onclick=\\\"pickOpening(14,this)\\\">\\n                    <div class=\\\"m-head\\\">\\n                        <span class=\\\"m-no\\\">14</span>\\n                        <span class=\\\"m-name\\\">名分</span>\\n                        <span class=\\\"m-dots\\\"></span>\\n                        <span class=\\\"m-flower\\\">✿</span>\\n                    </div>\\n                    <div class=\\\"m-dce\\\">\\n                        周劲羽让你和老公离婚，他娶你。至于结婚之后的事，他一点没想\\n                    </div>\\n                </div>\\n\\n            </div>\\n\\n\\n            <div class=\\\"m-tip\\\">\\n                · 点选一束花，进入对应开场白 ·\\n            </div>\\n\\n        </div>\\n\\n    </div>\\n\\n</div>\\n\\n\\n<audio\\n    id=\\\"bgm\\\"\\n    preload=\\\"auto\\\"\\n    loop\\n    src=\\\"http://music.163.com/song/media/outer/url?id=2715881285.mp3\\\"\\n></audio>\\n\\n\\n<script>\\n\\n/* =====================================================\\n   人物资料\\n   ===================================================== */\\n\\nconst persons = [\\n\\n    {\\n        img:'https://i.postimg.cc/Ss9DZPnH/IMG-20260928-144509.jpg',\\n        name:'向 呈',\\n        age:'29 岁',\\n        en:'XIANG CHENG',\\n        id:'Neverland 店长',\\n        per:'爹妈哥夫一体机，温柔甜水小苦瓜'\\n    },\\n\\n    {\\n        img:'https://i.postimg.cc/Ss9DZPnH/IMG-20260928-144509.jpg',\\n        name:'立 枫',\\n        age:'30 岁',\\n        en:'LI FENG',\\n        id:'自由职业',\\n        per:'冷漠暴戾，内心封闭生人勿近'\\n    }\\n\\n];\\n\\n\\n/* =====================================================\\n   角色\\n   ===================================================== */\\n\\nfunction openChar(i){\\n\\n    const ov =\\n        document.getElementById('ov'+i);\\n\\n    ov.classList.remove('closing');\\n    ov.classList.add('show');\\n}\\n\\n\\nfunction closeOverlay(i){\\n\\n    const ov =\\n        document.getElementById('ov'+i);\\n\\n    const fb =\\n        document.getElementById('fb'+i);\\n\\n    ov.classList.add('closing');\\n\\n    setTimeout(()=>{\\n\\n        ov.classList.remove(\\n            'show',\\n            'closing'\\n        );\\n\\n        fb.classList.remove('flipped');\\n\\n    },480);\\n}\\n\\n\\nfunction flipCard(i){\\n\\n    document\\n        .getElementById('fb'+i)\\n        .classList\\n        .toggle('flipped');\\n\\n}\\n\\n\\nfunction switchPerson(idx){\\n\\n    document\\n        .getElementById('tabA')\\n        .classList\\n        .toggle('on',idx===0);\\n\\n    document\\n        .getElementById('tabB')\\n        .classList\\n        .toggle('on',idx===1);\\n\\n    const p =\\n        persons[idx];\\n\\n    document\\n        .getElementById('f0img')\\n        .src = p.img;\\n\\n    document\\n        .getElementById('f0name')\\n        .textContent = p.name;\\n\\n    document\\n        .getElementById('f0age')\\n        .textContent =\\n            p.age + ' · ' + p.en;\\n\\n    document\\n        .getElementById('b0name')\\n        .textContent = p.name;\\n\\n    document\\n        .getElementById('b0age')\\n        .textContent = p.age;\\n\\n    document\\n        .getElementById('b0id')\\n        .textContent = p.id;\\n\\n    document\\n        .getElementById('b0per')\\n        .textContent = p.per;\\n}\\n\\n\\n/* =====================================================\\n   点击遮罩关闭\\n   ===================================================== */\\n\\n['ov0','ov1','ov2','ovMusic','ovOpen']\\n.forEach(id=>{\\n\\n    document\\n        .getElementById(id)\\n        .addEventListener('click',function(e){\\n\\n            if(e.target !== this)\\n                return;\\n\\n            if(id === 'ovMusic'){\\n\\n                closeMusic();\\n\\n            }else if(id === 'ovOpen'){\\n\\n                closeOpening();\\n\\n            }else{\\n\\n                closeOverlay(\\n                    Number(id.replace('ov',''))\\n                );\\n\\n            }\\n\\n        });\\n\\n});\\n\\n\\n/* =====================================================\\n   开场白\\n   ===================================================== */\\n\\nfunction openOpening(){\\n\\n    const ov =\\n        document.getElementById('ovOpen');\\n\\n    ov.classList.remove('closing');\\n    ov.classList.add('show');\\n\\n}\\n\\n\\nfunction closeOpening(){\\n\\n    const ov =\\n        document.getElementById('ovOpen');\\n\\n    ov.classList.add('closing');\\n\\n    setTimeout(()=>{\\n\\n        ov.classList.remove(\\n            'show',\\n            'closing'\\n        );\\n\\n    },480);\\n}\\n\\n\\nfunction pickOpening(id,el){\\n\\n    if(el)\\n        el.classList.add('picked');\\n\\n    switchToOpening(id);\\n\\n    setTimeout(\\n        closeOpening,\\n        420\\n    );\\n\\n}\\n\\n\\nasync function switchToOpening(id){\\n\\n    if(\\n        typeof getChatMessages === 'function' &&\\n        typeof setChatMessage === 'function'\\n    ){\\n\\n        try{\\n\\n            const messages =\\n                await getChatMessages(\\n                    \\\"0\\\",\\n                    {\\n                        include_swipe:true\\n                    }\\n                );\\n\\n            if(\\n                messages &&\\n                messages[0]?.swipes?.[id]\\n            ){\\n\\n                await setChatMessage(\\n                    messages[0].swipes[id],\\n                    0,\\n                    {\\n                        swipe_id:id,\\n                        refresh:\\n                            'display_and_render_current'\\n                    }\\n                );\\n\\n            }\\n\\n        }catch(e){\\n\\n            console.error(e);\\n\\n        }\\n\\n    }else{\\n\\n        console.log(\\n            'Loading Swipe Index:',\\n            id\\n        );\\n\\n    }\\n\\n}\\n\\n\\n/* =====================================================\\n   音乐\\n   ===================================================== */\\n\\nconst audio =\\n    document.getElementById('bgm');\\n\\nconst disc =\\n    document.getElementById('disc');\\n\\nconst fill =\\n    document.getElementById('fill');\\n\\nconst icoPlay =\\n    document.getElementById('icoPlay');\\n\\nconst icoPause =\\n    document.getElementById('icoPause');\\n\\n\\n/*\\n   播放状态：\\n\\n   firstInteraction\\n   = 是否已经发生过第一次点击\\n\\n   manuallyPaused\\n   = 是否是用户主动按暂停键\\n\\n   规则：\\n   1. 第一次点击任意位置 → 播放\\n   2. 正常播放期间点击任何位置 → 不产生影响\\n   3. 用户点击暂停 → manuallyPaused = true\\n   4. 暂停后任何普通点击 → 绝不自动播放\\n   5. 只有再次点击播放键 → 恢复播放\\n*/\\n\\nlet firstInteraction = false;\\nlet manuallyPaused = false;\\n\\n\\n/* =====================================================\\n   第一次点击 HTML 任意位置自动播放\\n   ===================================================== */\\n\\nfunction firstClickPlay(){\\n\\n    if(firstInteraction)\\n        return;\\n\\n    firstInteraction = true;\\n\\n    if(manuallyPaused)\\n        return;\\n\\n    audio\\n        .play()\\n        .then(()=>{\\n            setPlayUI(true);\\n        })\\n        .catch(()=>{\\n            /*\\n               如果浏览器第一次点击时仍拒绝播放，\\n               不锁死状态，后续点击仍可再次尝试。\\n            */\\n            firstInteraction = false;\\n        });\\n\\n}\\n\\n\\ndocument.addEventListener(\\n    'click',\\n    firstClickPlay,\\n    {\\n        capture:true\\n    }\\n);\\n\\n\\n/* =====================================================\\n   时间格式\\n   ===================================================== */\\n\\nfunction fmt(s){\\n\\n    if(!isFinite(s))\\n        return '0:00';\\n\\n    const m =\\n        Math.floor(s / 60);\\n\\n    const ss =\\n        Math.floor(s % 60);\\n\\n    return (\\n        m +\\n        ':' +\\n        (ss < 10 ? '0' : '') +\\n        ss\\n    );\\n}\\n\\n\\n/* =====================================================\\n   音乐状态\\n   ===================================================== */\\n\\naudio.addEventListener(\\n    'loadedmetadata',\\n    ()=>{\\n\\n        document\\n            .getElementById('tdur')\\n            .textContent =\\n                fmt(audio.duration);\\n\\n    }\\n);\\n\\n\\naudio.addEventListener(\\n    'timeupdate',\\n    ()=>{\\n\\n        if(isFinite(audio.duration)){\\n\\n            fill.style.width =\\n                (\\n                    audio.currentTime /\\n                    audio.duration *\\n                    100\\n                ) + '%';\\n\\n        }\\n\\n        document\\n            .getElementById('tcur')\\n            .textContent =\\n                fmt(audio.currentTime);\\n\\n    }\\n);\\n\\n\\nfunction setPlayUI(playing){\\n\\n    disc.classList.toggle(\\n        'playing',\\n        playing\\n    );\\n\\n    icoPlay.style.display =\\n        playing ? 'none' : 'block';\\n\\n    icoPause.style.display =\\n        playing ? 'block' : 'none';\\n}\\n\\n\\n/* =====================================================\\n   播放 / 暂停\\n   只有这个按钮可以控制主动暂停和恢复\\n   ===================================================== */\\n\\nfunction togglePlay(e){\\n\\n    e.stopPropagation();\\n\\n    /*\\n       播放键本身也是第一次点击，\\n       所以先记录第一次交互。\\n    */\\n\\n    if(!firstInteraction)\\n        firstInteraction = true;\\n\\n\\n    if(audio.paused){\\n\\n        /*\\n           只有主动点击这个按钮，\\n           才允许解除暂停状态。\\n        */\\n\\n        manuallyPaused = false;\\n\\n        audio\\n            .play()\\n            .then(()=>{\\n                setPlayUI(true);\\n            })\\n            .catch(()=>{\\n                setPlayUI(false);\\n            });\\n\\n    }else{\\n\\n        /*\\n           用户主动暂停。\\n        */\\n\\n        audio.pause();\\n\\n        manuallyPaused = true;\\n\\n        setPlayUI(false);\\n\\n    }\\n\\n}\\n\\n\\n/* =====================================================\\n   音乐弹窗\\n   ===================================================== */\\n\\nfunction openMusic(){\\n\\n    const ov =\\n        document.getElementById('ovMusic');\\n\\n    ov.classList.remove('closing');\\n    ov.classList.add('show');\\n\\n}\\n\\n\\nfunction closeMusic(){\\n\\n    const ov =\\n        document.getElementById('ovMusic');\\n\\n    ov.classList.add('closing');\\n\\n    setTimeout(()=>{\\n\\n        ov.classList.remove(\\n            'show',\\n            'closing'\\n        );\\n\\n    },480);\\n\\n}\\n\\n\\n/* =====================================================\\n   进度条\\n   ===================================================== */\\n\\ndocument\\n    .getElementById('bar')\\n    .addEventListener('click',e=>{\\n\\n        e.stopPropagation();\\n\\n        const bar =\\n            document.getElementById('bar');\\n\\n        const rect =\\n            bar.getBoundingClientRect();\\n\\n        const ratio =\\n            Math.min(\\n                Math.max(\\n                    (e.clientX - rect.left) /\\n                    rect.width,\\n                    0\\n                ),\\n                1\\n            );\\n\\n        if(isFinite(audio.duration)){\\n\\n            audio.currentTime =\\n                ratio * audio.duration;\\n\\n        }\\n\\n    });\\n\\n\\n/* =====================================================\\n   ESC\\n   ===================================================== */\\n\\ndocument.addEventListener(\\n    'keydown',\\n    e=>{\\n\\n        if(e.key !== 'Escape')\\n            return;\\n\\n        ['ov0','ov1','ov2']\\n        .forEach((id,i)=>{\\n\\n            const el =\\n                document.getElementById(id);\\n\\n            if(el.classList.contains('show'))\\n                closeOverlay(i);\\n\\n        });\\n\\n\\n        if(\\n            document\\n                .getElementById('ovMusic')\\n                .classList\\n                .contains('show')\\n        ){\\n\\n            closeMusic();\\n\\n        }\\n\\n\\n        if(\\n            document\\n                .getElementById('ovOpen')\\n                .classList\\n                .contains('show')\\n        ){\\n\\n            closeOpening();\\n\\n        }\\n\\n    }\\n);\\n\\n</script>\\n\\n</body>\\n</html>\\n```\",\"trimStrings\":[],\"placement\":[1,2],\"disabled\":false,\"markdownOnly\":true,\"promptOnly\":false,\"runOnEdit\":true,\"substituteRegex\":0,\"minDepth\":null,\"maxDepth\":null},{\"id\":\"42eb4872-e7fc-4a16-bfab-361a4f74f248\",\"scriptName\":\"状态栏\",\"findRegex\":\"<status>\\\\s*\\\\[时间:\\\\s*([^\\\\]]*)\\\\]\\\\s*\\\\[地点:\\\\s*([^\\\\]]*)\\\\]\\\\s*\\\\[年龄:\\\\s*([^\\\\]]*)\\\\]\\\\s*\\\\[状态:\\\\s*([^\\\\]]*)\\\\]\\\\s*\\\\[人格:\\\\s*([^\\\\]]*)\\\\]\\\\s*\\\\[char心声:\\\\s*([^\\\\]]*)\\\\]\\\\s*\\\\[npc心声:\\\\s*([^\\\\]]*)\\\\]\\\\s*\\\\[场外聊天:\\\\s*([^\\\\]]*)\\\\]\\\\s*\\\\[char待办:\\\\s*([^\\\\]]*)\\\\]\\\\s*\\\\[医嘱:\\\\s*([^\\\\]]*)\\\\]\\\\s*</status>\",\"replaceString\":\"```html\\n<!DOCTYPE html>\\n<html lang=\\\"zh-CN\\\">\\n<head>\\n<meta charset=\\\"UTF-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\\\">\\n\\n<link rel=\\\"preconnect\\\" href=\\\"https://fonts.googleapis.com\\\">\\n<link rel=\\\"preconnect\\\" href=\\\"https://fonts.gstatic.com\\\" crossorigin>\\n<link href=\\\"https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng&family=ZCOOL+XiaoWei&display=swap\\\" rel=\\\"stylesheet\\\">\\n\\n<style>\\n*,\\n*::before,\\n*::after{\\n    box-sizing:border-box;\\n    -webkit-tap-highlight-color:transparent;\\n}\\n\\nhtml,\\nbody{\\n    margin:0 !important;\\n    padding:0 !important;\\n    width:100%;\\n    height:auto;\\n    background:transparent !important;\\n    overflow:hidden !important;\\n}\\n\\nbody{\\n    font-family:\\\"ZCOOL XiaoWei\\\",\\\"PingFang SC\\\",\\\"Microsoft YaHei\\\",sans-serif;\\n    color:#435248;\\n}\\n\\nbutton{\\n    font:inherit;\\n    color:inherit;\\n    border:0;\\n    outline:0;\\n    background:none;\\n    padding:0;\\n    margin:0;\\n}\\n\\n/* =========================================================\\n   正则变量隐藏节点\\n========================================================= */\\n\\n.eden-data{\\n    display:none !important;\\n}\\n\\n/* =========================================================\\n   根容器\\n========================================================= */\\n\\n#eden-status{\\n    width:100%;\\n    max-width:450px;\\n    margin:0 auto;\\n}\\n\\n.eden-card{\\n    position:relative;\\n    width:100%;\\n    height:78px;\\n    overflow:hidden;\\n    border-radius:24px;\\n\\n    transition:\\n        height .52s cubic-bezier(.22,.8,.24,1),\\n        border-radius .45s ease,\\n        box-shadow .45s ease;\\n\\n    background-image:\\n        linear-gradient(\\n            180deg,\\n            rgba(250,249,239,.08) 0%,\\n            rgba(250,249,239,.02) 48%,\\n            rgba(241,244,231,.10) 100%\\n        ),\\n        url(\\\"https://i.postimg.cc/KzXnYrN7/IMG-20260928-150213.jpg\\\");\\n\\n    background-size:cover;\\n    background-position:center center;\\n    background-repeat:no-repeat;\\n\\n    box-shadow:\\n        0 14px 36px rgba(77,88,64,.18),\\n        0 3px 9px rgba(77,88,64,.10);\\n}\\n\\n.eden-card.open{\\n    height:450px;\\n    border-radius:25px;\\n}\\n\\n/* =========================================================\\n   顶部收缩栏\\n========================================================= */\\n\\n.eden-header{\\n    position:relative;\\n    z-index:20;\\n\\n    width:100%;\\n    min-height:78px;\\n\\n    padding:11px 14px 10px 12px;\\n\\n    display:flex;\\n    align-items:center;\\n    gap:12px;\\n\\n    cursor:pointer;\\n\\n    background:\\n        linear-gradient(\\n            90deg,\\n            rgba(249,249,239,.77) 0%,\\n            rgba(247,248,236,.64) 50%,\\n            rgba(245,246,231,.53) 100%\\n        );\\n\\n    border-bottom:1px solid rgba(109,127,96,.12);\\n\\n    touch-action:manipulation;\\n}\\n\\n.eden-avatar{\\n    width:55px;\\n    height:55px;\\n    flex:0 0 55px;\\n\\n    border-radius:18px;\\n    overflow:hidden;\\n\\n    background:#eef0df;\\n\\n    border:1px solid rgba(255,255,255,.78);\\n\\n    box-shadow:\\n        0 4px 12px rgba(72,85,66,.15),\\n        inset 0 0 0 1px rgba(108,126,91,.08);\\n}\\n\\n.eden-avatar img{\\n    width:100%;\\n    height:100%;\\n    display:block;\\n    object-fit:cover;\\n}\\n\\n.eden-head-info{\\n    min-width:0;\\n    flex:1;\\n\\n    display:flex;\\n    flex-direction:column;\\n    justify-content:center;\\n    gap:5px;\\n}\\n\\n.eden-time{\\n    font-size:17px;\\n    line-height:1.1;\\n    letter-spacing:.2px;\\n    color:#425044;\\n    white-space:nowrap;\\n    overflow:hidden;\\n    text-overflow:ellipsis;\\n}\\n\\n.eden-age{\\n    font-size:12px;\\n    line-height:1;\\n    color:#6b786d;\\n    letter-spacing:.5px;\\n}\\n\\n.eden-toggle{\\n    width:30px;\\n    height:30px;\\n    flex:0 0 30px;\\n\\n    display:flex;\\n    align-items:center;\\n    justify-content:center;\\n\\n    color:#6c7c68;\\n\\n    transition:transform .45s ease;\\n}\\n\\n.eden-toggle svg{\\n    width:18px;\\n    height:18px;\\n    display:block;\\n}\\n\\n.eden-card.open .eden-toggle{\\n    transform:rotate(180deg);\\n}\\n\\n/* =========================================================\\n   展开内容\\n========================================================= */\\n\\n.eden-content{\\n    position:absolute;\\n\\n    left:0;\\n    right:0;\\n    top:78px;\\n    bottom:0;\\n\\n    min-height:0;\\n\\n    display:flex;\\n    flex-direction:column;\\n\\n    opacity:0;\\n    transform:translateY(9px);\\n\\n    pointer-events:none;\\n\\n    transition:\\n        opacity .32s ease .05s,\\n        transform .42s cubic-bezier(.22,.8,.24,1) .04s;\\n}\\n\\n.eden-card.open .eden-content{\\n    opacity:1;\\n    transform:translateY(0);\\n    pointer-events:auto;\\n}\\n\\n/* =========================================================\\n   三个页面切换\\n========================================================= */\\n\\n.eden-tabs{\\n    position:relative;\\n    z-index:10;\\n\\n    flex:0 0 55px;\\n\\n    display:grid;\\n    grid-template-columns:repeat(3,1fr);\\n    align-items:stretch;\\n\\n    padding:0 12px;\\n\\n    background:rgba(248,249,237,.72);\\n\\n    border-bottom:1px solid rgba(100,116,91,.12);\\n}\\n\\n.eden-tab{\\n    position:relative;\\n\\n    min-width:0;\\n\\n    display:flex;\\n    align-items:center;\\n    justify-content:center;\\n    gap:6px;\\n\\n    color:#718072;\\n\\n    font-size:12px;\\n    letter-spacing:.3px;\\n\\n    cursor:pointer;\\n\\n    transition:\\n        color .25s ease,\\n        opacity .25s ease;\\n\\n    touch-action:manipulation;\\n}\\n\\n.eden-tab svg{\\n    width:15px;\\n    height:15px;\\n    flex:0 0 15px;\\n\\n    stroke:currentColor;\\n    fill:none;\\n\\n    stroke-width:1.55;\\n    stroke-linecap:round;\\n    stroke-linejoin:round;\\n}\\n\\n.eden-tab::after{\\n    content:\\\"\\\";\\n\\n    position:absolute;\\n\\n    left:24%;\\n    right:24%;\\n    bottom:-1px;\\n\\n    height:2px;\\n\\n    border-radius:4px 4px 0 0;\\n\\n    background:#86947d;\\n\\n    opacity:0;\\n\\n    transform:scaleX(.35);\\n\\n    transition:\\n        opacity .28s ease,\\n        transform .28s ease;\\n}\\n\\n.eden-tab.active{\\n    color:#4f6253;\\n}\\n\\n.eden-tab.active::after{\\n    opacity:1;\\n    transform:scaleX(1);\\n}\\n\\n/* =========================================================\\n   页面滚动容器\\n   三页都可以上下滑动\\n   滚动条完全隐藏\\n========================================================= */\\n\\n.eden-page-wrap{\\n    position:relative;\\n    min-height:0;\\n    flex:1;\\n    overflow:hidden;\\n}\\n\\n.eden-page{\\n    position:absolute;\\n\\n    top:0;\\n    left:0;\\n    right:0;\\n    bottom:0;\\n\\n    padding:14px 15px 18px;\\n\\n    overflow-y:auto;\\n    overflow-x:hidden;\\n\\n    overscroll-behavior:contain;\\n    -webkit-overflow-scrolling:touch;\\n\\n    touch-action:pan-y;\\n\\n    scrollbar-width:none;\\n\\n    opacity:0;\\n    transform:translateX(14px);\\n\\n    pointer-events:none;\\n\\n    transition:\\n        opacity .3s ease,\\n        transform .35s cubic-bezier(.22,.8,.24,1);\\n}\\n\\n/* Chrome / Android / WebView */\\n.eden-page::-webkit-scrollbar{\\n    display:none !important;\\n    width:0 !important;\\n    height:0 !important;\\n}\\n\\n.eden-page::-webkit-scrollbar-track{\\n    display:none !important;\\n}\\n\\n.eden-page::-webkit-scrollbar-thumb{\\n    display:none !important;\\n    background:transparent !important;\\n}\\n\\n.eden-page.active{\\n    opacity:1;\\n    transform:translateX(0);\\n    pointer-events:auto;\\n}\\n\\n/* =========================================================\\n   第一页\\n========================================================= */\\n\\n.page-one-inner{\\n    width:100%;\\n\\n    display:flex;\\n    flex-direction:column;\\n\\n    gap:13px;\\n\\n    padding-bottom:4px;\\n}\\n\\n/* =========================================================\\n   基础信息\\n========================================================= */\\n\\n.info-block{\\n    width:100%;\\n\\n    padding:15px 16px 14px;\\n\\n    border-radius:19px;\\n\\n    background:rgba(250,251,243,.72);\\n\\n    border:1px solid rgba(255,255,255,.62);\\n\\n    box-shadow:\\n        0 5px 16px rgba(77,87,69,.08);\\n}\\n\\n.info-row{\\n    display:flex;\\n    flex-direction:column;\\n    gap:6px;\\n}\\n\\n.info-row + .info-row{\\n    margin-top:14px;\\n}\\n\\n.info-label{\\n    font-size:10px;\\n    line-height:1;\\n\\n    letter-spacing:1.6px;\\n\\n    color:#7b877a;\\n}\\n\\n.info-value{\\n    font-size:14px;\\n    line-height:1.65;\\n\\n    color:#3e4e42;\\n\\n    word-break:break-word;\\n}\\n\\n/* =========================================================\\n   心声标题\\n========================================================= */\\n\\n.thought-title{\\n    display:flex;\\n    align-items:center;\\n    justify-content:space-between;\\n\\n    padding:1px 4px 0;\\n}\\n\\n.thought-title span:first-child{\\n    font-size:15px;\\n\\n    color:#4a5d4d;\\n\\n    letter-spacing:.6px;\\n}\\n\\n.thought-title span:last-child{\\n    font-size:10px;\\n\\n    color:#96a091;\\n\\n    letter-spacing:1.4px;\\n}\\n\\n/* =========================================================\\n   四人心声\\n========================================================= */\\n\\n.thought-list{\\n    width:100%;\\n\\n    display:flex;\\n    flex-direction:column;\\n\\n    gap:11px;\\n\\n    padding-top:2px;\\n    padding-bottom:2px;\\n}\\n\\n.thought-bubble{\\n    position:relative;\\n\\n    width:fit-content;\\n\\n    max-width:87%;\\n    min-width:55%;\\n\\n    padding:13px 15px;\\n\\n    border-radius:19px;\\n\\n    box-shadow:\\n        0 5px 15px rgba(75,88,67,.08);\\n\\n    animation:\\n        thoughtBreath 4.8s ease-in-out infinite;\\n\\n    will-change:transform;\\n}\\n\\n.thought-name{\\n    display:block;\\n\\n    margin-bottom:6px;\\n\\n    font-size:11px;\\n\\n    letter-spacing:.8px;\\n\\n    line-height:1;\\n}\\n\\n.thought-text{\\n    display:block;\\n\\n    font-size:13px;\\n\\n    line-height:1.72;\\n\\n    word-break:break-word;\\n\\n    white-space:pre-wrap;\\n}\\n\\n/* 向呈 */\\n\\n.thought--xiang{\\n    align-self:flex-start;\\n\\n    margin-left:1%;\\n    margin-right:11%;\\n\\n    background:rgba(233,239,216,.86);\\n\\n    border:1px solid rgba(172,189,147,.30);\\n\\n    border-radius:18px 18px 18px 5px;\\n\\n    color:#4c5b48;\\n\\n    animation-delay:0s;\\n}\\n\\n/* 立枫 */\\n\\n.thought--li{\\n    align-self:flex-end;\\n\\n    margin-left:12%;\\n    margin-right:1%;\\n\\n    background:rgba(229,238,234,.88);\\n\\n    border:1px solid rgba(157,184,171,.27);\\n\\n    border-radius:18px 18px 5px 18px;\\n\\n    color:#4c5d57;\\n\\n    animation-delay:-1.15s;\\n}\\n\\n/* 周劲羽 */\\n\\n.thought--zhou{\\n    align-self:flex-start;\\n\\n    margin-left:6%;\\n    margin-right:15%;\\n\\n    background:rgba(239,235,218,.90);\\n\\n    border:1px solid rgba(190,179,143,.26);\\n\\n    border-radius:20px 16px 18px 7px;\\n\\n    color:#5c5644;\\n\\n    animation-delay:-2.3s;\\n}\\n\\n/* 蒙莉 */\\n\\n.thought--meng{\\n    align-self:flex-end;\\n\\n    margin-left:16%;\\n    margin-right:5%;\\n\\n    background:rgba(239,232,230,.88);\\n\\n    border:1px solid rgba(191,164,159,.25);\\n\\n    border-radius:17px 19px 7px 19px;\\n\\n    color:#624f4c;\\n\\n    animation-delay:-3.45s;\\n}\\n\\n@keyframes thoughtBreath{\\n\\n    0%,100%{\\n        transform:translateY(0);\\n    }\\n\\n    50%{\\n        transform:translateY(-3px);\\n    }\\n\\n}\\n\\n/* =========================================================\\n   待办\\n========================================================= */\\n\\n.todo-block{\\n    width:100%;\\n\\n    padding:15px 16px 16px;\\n\\n    border-radius:18px;\\n\\n    background:rgba(250,250,242,.74);\\n\\n    border:1px solid rgba(255,255,255,.60);\\n\\n    margin-bottom:3px;\\n}\\n\\n.todo-title{\\n    margin-bottom:10px;\\n\\n    font-size:15px;\\n\\n    letter-spacing:.7px;\\n\\n    color:#4a5c4e;\\n}\\n\\n.todo-list{\\n    display:flex;\\n\\n    flex-direction:column;\\n\\n    gap:8px;\\n\\n    width:100%;\\n\\n    text-align:left;\\n}\\n\\n.todo-item{\\n    position:relative;\\n\\n    padding:8px 10px 8px 22px;\\n\\n    font-size:13px;\\n\\n    line-height:1.55;\\n\\n    color:#4c584f;\\n\\n    text-align:left;\\n\\n    word-break:break-word;\\n}\\n\\n.todo-item::before{\\n    content:\\\"\\\";\\n\\n    position:absolute;\\n\\n    left:4px;\\n    top:14px;\\n\\n    width:6px;\\n    height:6px;\\n\\n    border-radius:50%;\\n\\n    background:#96a68b;\\n}\\n\\n/* =========================================================\\n   第二页：场外聊天\\n========================================================= */\\n\\n.chat-page{\\n    padding:14px 15px 18px;\\n}\\n\\n.chat-intro{\\n    padding:2px 4px 10px;\\n\\n    font-size:11px;\\n\\n    color:#788378;\\n\\n    letter-spacing:.6px;\\n}\\n\\n.chat-list{\\n    width:100%;\\n\\n    display:flex;\\n    flex-direction:column;\\n\\n    gap:10px;\\n\\n    padding-bottom:3px;\\n}\\n\\n.chat-row{\\n    width:100%;\\n\\n    display:flex;\\n}\\n\\n.chat-row.other{\\n    justify-content:flex-start;\\n}\\n\\n.chat-row.user{\\n    justify-content:flex-end;\\n}\\n\\n.chat-bubble{\\n    max-width:82%;\\n\\n    padding:9px 12px 10px;\\n\\n    box-shadow:\\n        0 3px 9px rgba(66,77,65,.07);\\n}\\n\\n.chat-row.other .chat-bubble{\\n    background:rgba(249,250,244,.90);\\n\\n    border:1px solid rgba(255,255,255,.67);\\n\\n    border-radius:4px 16px 16px 16px;\\n}\\n\\n.chat-row.user .chat-bubble{\\n    background:rgba(222,235,213,.93);\\n\\n    border:1px solid rgba(190,208,178,.28);\\n\\n    border-radius:16px 4px 16px 16px;\\n}\\n\\n.chat-name{\\n    display:block;\\n\\n    margin-bottom:4px;\\n\\n    font-size:10px;\\n\\n    line-height:1.1;\\n\\n    letter-spacing:.45px;\\n\\n    color:#829080;\\n}\\n\\n.chat-row.user .chat-name{\\n    text-align:right;\\n\\n    color:#71836d;\\n}\\n\\n.chat-text{\\n    font-size:13px;\\n\\n    line-height:1.62;\\n\\n    color:#465349;\\n\\n    white-space:pre-wrap;\\n\\n    word-break:break-word;\\n}\\n\\n/* =========================================================\\n   第三页：医嘱\\n========================================================= */\\n\\n.medical-page{\\n    padding:12px 15px 18px;\\n}\\n\\n.prescription-paper{\\n    position:relative;\\n\\n    width:100%;\\n\\n    min-height:100%;\\n\\n    padding:23px 18px 34px;\\n\\n    background:\\n        linear-gradient(\\n            180deg,\\n            rgba(255,255,255,.985),\\n            rgba(252,252,249,.99)\\n        );\\n\\n    color:#262d29;\\n\\n    box-shadow:\\n        0 7px 20px rgba(39,47,40,.14);\\n\\n    border:1px solid rgba(217,220,213,.9);\\n}\\n\\n.prescription-head{\\n    padding-bottom:13px;\\n\\n    border-bottom:1px solid #272c29;\\n}\\n\\n.prescription-main-title{\\n    font-family:\\n        \\\"ZCOOL XiaoWei\\\",\\n        \\\"PingFang SC\\\",\\n        sans-serif;\\n\\n    font-size:18px;\\n\\n    letter-spacing:2.5px;\\n\\n    color:#242a27;\\n}\\n\\n.prescription-meta{\\n    margin-top:15px;\\n\\n    display:grid;\\n\\n    grid-template-columns:1fr 1fr;\\n\\n    gap:0;\\n\\n    border-top:1px solid #b9bdb8;\\n    border-left:1px solid #b9bdb8;\\n}\\n\\n.prescription-meta-cell{\\n    min-height:31px;\\n\\n    padding:7px 8px;\\n\\n    border-right:1px solid #b9bdb8;\\n    border-bottom:1px solid #b9bdb8;\\n\\n    font-family:\\n        \\\"Ma Shan Zheng\\\",\\n        \\\"ZCOOL XiaoWei\\\",\\n        sans-serif;\\n\\n    font-size:12px;\\n\\n    line-height:1.35;\\n\\n    color:#343936;\\n}\\n\\n.prescription-section{\\n    margin-top:18px;\\n}\\n\\n.prescription-section-title{\\n    padding-bottom:7px;\\n\\n    border-bottom:1px solid #303632;\\n\\n    font-family:\\n        \\\"ZCOOL XiaoWei\\\",\\n        \\\"PingFang SC\\\",\\n        sans-serif;\\n\\n    font-size:13px;\\n\\n    letter-spacing:1.1px;\\n\\n    color:#252b28;\\n}\\n\\n.medical-note{\\n    margin-top:13px;\\n\\n    font-family:\\n        \\\"Ma Shan Zheng\\\",\\n        \\\"ZCOOL XiaoWei\\\",\\n        sans-serif;\\n\\n    font-size:16px;\\n\\n    line-height:2;\\n\\n    color:#252a27;\\n\\n    white-space:pre-wrap;\\n\\n    word-break:break-word;\\n}\\n\\n/* =========================================================\\n   手机\\n========================================================= */\\n\\n@media (max-width:480px){\\n\\n    #eden-status{\\n        width:100%;\\n    }\\n\\n    .eden-card{\\n        border-radius:21px;\\n    }\\n\\n    .eden-card.open{\\n        height:450px;\\n        border-radius:22px;\\n    }\\n\\n    .eden-header{\\n        padding-left:11px;\\n        padding-right:11px;\\n    }\\n\\n    .eden-page{\\n        padding-left:12px;\\n        padding-right:12px;\\n    }\\n\\n    .thought-bubble{\\n        max-width:90%;\\n    }\\n\\n    .chat-bubble{\\n        max-width:86%;\\n    }\\n\\n}\\n</style>\\n</head>\\n\\n<body>\\n\\n<div id=\\\"eden-status\\\">\\n\\n    <div class=\\\"eden-card\\\" id=\\\"edenCard\\\">\\n\\n        <!-- =====================================================\\n             正则捕获组\\n        ====================================================== -->\\n\\n        <div class=\\\"eden-data\\\" id=\\\"eden-v1\\\">$1</div>\\n        <div class=\\\"eden-data\\\" id=\\\"eden-v2\\\">$2</div>\\n        <div class=\\\"eden-data\\\" id=\\\"eden-v3\\\">$3</div>\\n        <div class=\\\"eden-data\\\" id=\\\"eden-v4\\\">$4</div>\\n        <div class=\\\"eden-data\\\" id=\\\"eden-v5\\\">$5</div>\\n        <div class=\\\"eden-data\\\" id=\\\"eden-v6\\\">$6</div>\\n        <div class=\\\"eden-data\\\" id=\\\"eden-v7\\\">$7</div>\\n        <div class=\\\"eden-data\\\" id=\\\"eden-v8\\\">$8</div>\\n        <div class=\\\"eden-data\\\" id=\\\"eden-v9\\\">$9</div>\\n        <div class=\\\"eden-data\\\" id=\\\"eden-v10\\\">$10</div>\\n\\n        <!-- =====================================================\\n             顶部\\n        ====================================================== -->\\n\\n        <div class=\\\"eden-header\\\" id=\\\"edenHeader\\\">\\n\\n            <div class=\\\"eden-avatar\\\">\\n\\n                <img\\n                    src=\\\"https://i.postimg.cc/Ss9DZPnH/IMG-20260928-144509.jpg\\\"\\n                    alt=\\\"\\\"\\n                >\\n\\n            </div>\\n\\n            <div class=\\\"eden-head-info\\\">\\n\\n                <div\\n                    class=\\\"eden-time\\\"\\n                    id=\\\"edenTime\\\"\\n                ></div>\\n\\n                <div\\n                    class=\\\"eden-age\\\"\\n                    id=\\\"edenAge\\\"\\n                ></div>\\n\\n            </div>\\n\\n            <div class=\\\"eden-toggle\\\">\\n\\n                <svg viewBox=\\\"0 0 24 24\\\">\\n                    <path d=\\\"M7 9.5L12 14.5L17 9.5\\\"></path>\\n                </svg>\\n\\n            </div>\\n\\n        </div>\\n\\n        <!-- =====================================================\\n             展开\\n        ====================================================== -->\\n\\n        <div class=\\\"eden-content\\\">\\