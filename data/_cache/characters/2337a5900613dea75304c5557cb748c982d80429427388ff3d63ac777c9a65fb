?:【|\\\\\\\\[)?(?:剧情日期|当前日期|日期)\\\\\\\\s*[:：]\\\\\\\\s*' + dateToken + '\\\\\\\\s*(?:】|\\\\\\\\])?\\\\\\\\s*$');\\n    const legacyRE = new RegExp('^' + dateToken + '(?:\\\\\\\\s+(?:周[一二三四五六日天]|星期[一二三四五六日天]))?\\\\\\\\s+\\\\\\\\d{1,2}[:：]\\\\\\\\d{2}\\\\\\\\s*$');\\n    let fence = null;\\n    for (const raw of cleaned.split(/\\\\r?\\\\n/)) {\\n      let line = raw.trim();\\n      const mark = line.match(/^(`{3,}|~{3,})/);\\n      if (mark) { if (!fence) fence = mark[1][0]; else if (fence === mark[1][0]) fence = null; continue; }\\n      if (fence || /^>/.test(line)) continue;\\n      line = line.replace(/^\\\\*\\\\*(.*)\\\\*\\\\*$/, '$1').trim();\\n      if (role === 'user') {\\n        const directive = line.match(directiveRE);\\n        if (directive) return { recognized: true, date: normal(directive), source: '玩家日期指令' };\\n        if (/^(?:【|\\\\[)?(?:剧情日期|当前日期|日期)\\\\s*[:：]/.test(line)) return { recognized: true, date: null, source: '玩家日期指令无效' };\\n      }\\n      const header = line.match(headerRE) || (role === 'assistant' && line.match(legacyRE));\\n      if (header) return { recognized: true, date: normal(header), source: role === 'user' ? '玩家日期头' : '剧情顶部日期' };\\n      if (/^[\\\\[【［]\\\\s*\\\\d{4}[-/年][^\\\\r\\\\n]*[|｜]/.test(line)) return { recognized: true, date: null, source: '顶部日期格式无效' };\\n    }\\n    return { recognized: false, date: null, source: '' };\\n  }\\n\\n  function resolveDate(messages, type) {\\n    let rows = Array.isArray(messages) ? messages.filter(row => row && !row.is_hidden) : [];\\n    // Before regeneration, ignore an old assistant answer if it is still present.\\n    if ((type === 'swipe' || type === 'regenerate') && rows[rows.length - 1]?.role === 'assistant') rows = rows.slice(0, -1);\\n    for (let i = rows.length - 1; i >= 0; i--) {\\n      const row = rows[i];\\n      if (row.role !== 'assistant' && row.role !== 'user') continue;\\n      const result = leadingDate(row.message, row.role);\\n      if (result.recognized) return { ...result, messageId: row.message_id ?? null };\\n    }\\n    return { recognized: false, date: null, source: '没有有效剧情日期', messageId: null };\\n  }\\n\\n  function matches(entry, rule) {\\n    return String(entry.name || '').trim() === rule.name ||\\n      String(entry.content || '').trimStart().startsWith('<' + rule.tag + '>');\\n  }\\n  function defaultHost() {\\n    const helper = global.TavernHelper || {};\\n    const fn = name => typeof global[name] === 'function' ? global[name].bind(global)\\n      : typeof helper[name] === 'function' ? helper[name].bind(helper) : null;\\n    const host = { events: global.tavern_events || {} };\\n    for (const name of ['getChatMessages', 'getCharWorldbookNames', 'getChatWorldbookName', 'getWorldbook',\\n      'updateWorldbookWith', 'eventOn', 'eventMakeFirst', 'eventRemoveListener', 'appendInexistentScriptButtons', 'getButtonEvent']) host[name] = fn(name);\\n    host.scope = () => {\\n      try {\\n        const st = global.SillyTavern || global.parent?.SillyTavern;\\n        const ctx = st?.getContext?.();\\n        const chat = st?.getCurrentChatId?.() ?? ctx?.getCurrentChatId?.() ?? ctx?.chatId ?? '';\\n        return JSON.stringify([fn('getCharAvatarPath')?.() || '', String(chat)]);\\n      } catch (_) { return ''; }\\n    };\\n    host.notify = (text, title) => {\\n      try {\\n        const toast = global.toastr || global.parent?.toastr;\\n        if (toast?.info) toast.info(text, title, { closeButton: true, timeOut: 5000 });\\n        else global.console?.info('[人生经历开关]', title, text);\\n      } catch (_) {}\\n    };\\n    host.warn = error => global.console?.warn('[人生经历开关]', error);\\n    return host;\\n  }\\n\\n  function createGate(host = defaultHost()) {\\n    let started = false, stopped = false, revision = 0, chain = Promise.resolve();\\n    let generation = null, lastWarning = '';\\n    let state = { scope: '', date: null, source: '', rows: [], status: 'waiting' };\\n    const subscriptions = [];\\n    const scope = () => host.scope?.() || '';\\n    const notify = (text, title) => { try { host.notify?.(text, title); } catch (_) {} };\\n    const messages = () => host.getChatMessages('0-{{lastMessageId}}', { role: 'all', include_swipes: false });\\n    function warnOnce(text, key) {\\n      if (lastWarning === key) return;\\n      lastWarning = key;\\n      notify(html(text), '人生经历开关');\\n    }\\n    function books() {\\n      const bound = host.getCharWorldbookNames('current') || {};\\n      return [...new Set([bound.primary, ...(bound.additional || []), host.getChatWorldbookName?.('current')].filter(Boolean))];\\n    }\\n    async function catalog() {\\n      return (await Promise.all(books().map(async world =>\\n        (await host.getWorldbook(world)).map(entry => ({ world, entry })) ))).flat();\\n    }\\n    function identify(all) {\\n      const rows = [], issues = [];\\n      for (const rule of RULES) {\\n        const found = all.filter(({ entry }) => matches(entry, rule));\\n        if (found.length === 1) rows.push({ ...found[0], rule });\\n        else issues.push((found.length ? '存在重名条目，未修改：' : '未找到条目：') + rule.name);\\n      }\\n      return { rows, issues };\\n    }\\n    async function apply(run, captured, options) {\\n      const current = () => !stopped && run === revision && captured === scope();\\n      if (!current()) return getState();\\n      const resolved = resolveDate(messages(), options.type || 'normal');\\n      state = { scope: captured, date: resolved.date, source: resolved.source, rows: [], status: 'checking' };\\n      if (!resolved.date) {\\n        state.status = 'unknown-date';\\n        if (options.notify !== false) warnOnce('未识别到有效剧情日期，已保留现有开关。请检查顶部日期，或发送“剧情日期：2021-09-01”（日期按实际剧情填写）。', captured + ':date:' + resolved.source);\\n        return getState();\\n      }\\n      const all = await catalog();\\n      if (!current()) return getState();\\n      const { rows, issues } = identify(all);\\n      const opened = [], failures = [];\\n      const result = rows.map(({ world, entry, rule }) => ({ world, uid: entry.uid, name: entry.name || rule.name, enabled: entry.enabled, wanted: resolved.date >= rule.start }));\\n      const grouped = new Map();\\n      for (const row of rows) {\\n        if (row.entry.enabled === (resolved.date >= row.rule.start)) continue;\\n        if (!grouped.has(row.world)) grouped.set(row.world, []);\\n        grouped.get(row.world).push(row);\\n      }\\n      for (const [world, planned] of grouped) {\\n        if (!current()) return getState();\\n        let changed = [];\\n        try {\\n          // The updater receives the current stored entries. Never write an old\\n          // snapshot over text that the user has since edited. Only enabled changes.\\n          const saved = await host.updateWorldbookWith(world, live => {\\n            changed = [];\\n            if (!current()) return live;\\n            return live.map(entry => {\\n              const row = planned.find(item => item.entry.uid === entry.uid && matches(entry, item.rule));\\n              if (!row || live.filter(item => matches(item, row.rule)).length !== 1) return entry;\\n              const enabled = resolved.date >= row.rule.start;\\n              if (entry.enabled === enabled) return entry;\\n              changed.push({ uid: entry.uid, name: entry.name || row.rule.name, enabled });\\n              return { ...entry, enabled };\\n            });\\n          }, { render: 'immediate' });\\n          for (const change of changed) {\\n            const actual = saved.find(entry => entry.uid === change.uid);\\n            if (actual?.enabled !== change.enabled) {\\n              failures.push('开关未成功更新：' + change.name); continue;\\n            }\\n            const summary = result.find(row => row.world === world && row.uid === change.uid);\\n            if (summary) { summary.enabled = actual.enabled; summary.name = actual.name || summary.name; }\\n            if (change.enabled) opened.push(actual.name || change.name);\\n          }\\n        } catch (error) {\\n          host.warn?.(error);\\n          failures.push('开关保存失败：' + planned.map(item => item.rule.name).join('、'));\\n        }\\n      }\\n      if (!current()) return getState();\\n      state = { scope: captured, date: resolved.date, source: resolved.source, rows: result, status: failures.length ? 'error' : 'ready' };\\n      if (options.notify !== false && opened.length) notify([...new Set(opened)].map(html).join('； '), '新增开启');\\n      const problems = [...issues, ...failures];\\n      if (problems.length && options.notify !== false) warnOnce(problems.join('；'), captured + ':' + problems.join('|'));\\n      else if (!problems.length) lastWarning = '';\\n      return getState();\\n    }\\n    function sync(options = {}) {\\n      const run = ++revision, captured = scope();\\n      chain = chain.catch(() => {}).then(() => apply(run, captured, options)).catch(error => {\\n        host.warn?.(error);\\n        if (!stopped && run === revision && captured === scope()) {\\n          state = { ...state, scope: captured, status: 'error' };\\n          if (options.notify !== false) warnOnce('经历开关更新失败：' + String(error.message || error), captured + ':error:' + String(error));\\n        }\\n        return getState();\\n      });\\n      return chain;\\n    }\\n    function getState() {\\n      return state.scope === scope() ? copy(state) : { scope: scope(), date: null, source: '', rows: [], status: 'waiting' };\\n    }\\n    function showDate() {\\n      const resolved = resolveDate(messages(), 'normal');\\n      notify('当前剧情日期：' + html(resolved.date || '未识别') + '；日期来源：' + html(resolved.source), '经历日期');\\n      return resolved;\\n    }\\n    async function showStatus() {\\n      const captured = scope();\\n      const { rows, issues } = identify(await catalog());\\n      if (stopped || captured !== scope()) return;\\n      notify(rows.map(({ entry, rule }) => html(entry.name || rule.name) + '：' + (entry.enabled ? '开启' : '关闭')).concat(issues.map(html)).join('； ') || '未找到经历条目', '经历开关状态');\\n    }\\n    function listen(event, callback, first = false) {\\n      if (!event) return;\\n      const safe = (...args) => {\\n        try { return Promise.resolve(callback(...args)).catch(error => host.warn?.(error)); }\\n        catch (error) { host.warn?.(error); }\\n      };\\n      const handle = (first && host.eventMakeFirst || host.eventOn)(event, safe);\\n      subscriptions.push({ event, listener: safe, handle });\\n    }\\n    function historyChanged() { if (!generation) return sync(); }\\n    function start() {\\n      if (started || stopped) return Promise.resolve(getState());\\n      for (const method of ['getChatMessages', 'getCharWorldbookNames', 'getWorldbook', 'updateWorldbookWith', 'eventOn']) {\\n        if (!host[method]) throw new Error('酒馆助手缺少接口：' + method);\\n      }\\n      started = true;\\n      listen(host.events.GENERATION_AFTER_COMMANDS, (type, options, dryRun) => {\\n        if (dryRun) return;\\n        generation = { silent: type === 'quiet' || type === 'impersonate' };\\n        // This promise is awaited by the generation event, before worldbook loading.\\n        if (!generation.silent) return sync({ type: type || 'normal' });\\n      }, true);\\n      const finished = () => {\\n        const previous = generation; generation = null;\\n        if (!previous?.silent) return sync();\\n      };\\n      listen(host.events.GENERATION_ENDED, finished);\\n      listen(host.events.GENERATION_STOPPED, finished);\\n      listen(host.events.CHAT_CHANGED, () => { generation = null; return sync(); });\\n      for (const event of new Set([host.events.MESSAGE_SENT, host.events.MESSAGE_RECEIVED, host.events.MESSAGE_UPDATED,\\n        host.events.MESSAGE_SWIPED, host.events.MESSAGE_DELETED, host.events.CHARACTER_FIRST_MESSAGE_SELECTED, host.events.CHARACTER_MESSAGE_RENDERED])) listen(event, historyChanged);\\n      if (host.appendInexistentScriptButtons && host.getButtonEvent) {\\n        host.appendInexistentScriptButtons([{ name: '查看经历日期', visible: true }, { name: '查看经历状态', visible: true }]);\\n        listen(host.getButtonEvent('查看经历日期'), showDate);\\n        listen(host.getButtonEvent('查看经历状态'), showStatus);\\n      }\\n      return sync();\\n    }\\n    function stop() {\\n      stopped = true; revision++;\\n      for (const { event, listener, handle } of subscriptions.splice(0)) {\\n        try { if (typeof handle?.stop === 'function') handle.stop(); else host.eventRemoveListener?.(event, listener); } catch (_) {}\\n      }\\n    }\\n    return { start, stop, sync, getState, showDate, showStatus, _test: { validDate, leadingDate, resolveDate } };\\n  }\\n  // Retain this marker so the independent opening-switch script recognizes the\\n  // date controller and leaves these three entries to it.\\n  global.XJW_DATE_GATE_CREATE = createGate;\\n  if (global.__XJW_DATE_GATE_TEST__) return;\\n  try {\\n    global.XJW_DATE_GATE_API?.stop?.();\\n    const api = createGate(); global.XJW_DATE_GATE_API = api;\\n    api.start().catch(error => global.console?.error('[人生经历开关]', error));\\n    global.addEventListener('pagehide', api.stop, { once: true });\\n  } catch (error) {\\n    global.console?.error('[人生经历开关]', error);\\n    try { (global.toastr || global.parent?.toastr)?.error?.(String(error.message || error), '人生经历开关未启动'); } catch (_) {}\\n  }\\n})(typeof window === 'undefined' ? globalThis : window);\\n\\n\",\"info\":\"\",\"button\":{\"enabled\":false,\"buttons\":[{\"name\":\"查看经历日期\",\"visible\":true},{\"name\":\"查看经历状态\",\"visible\":true}]},\"data\":{},\"export_with\":{\"data\":false,\"button\":false}},{\"type\":\"script\",\"enabled\":true,\"name\":\"世界书条目开关\",\"id\":\"1449fad8-e05e-4095-b5cc-3ca208617d50\",\"content\":\"/* 世界书条目开关 2.1：按开场切换，仅清理由本脚本开启的条目。 */\\n(function(global){\\n'use strict';\\nconst PROTECTED=new Set([\\\"=====AI规范=====\\\", \\\"情感观\\\", \\\"=====NPC档案=====\\\", \\\"=====状态栏=====\\\", \\\"=====身份与时期=====\\\", \\\"顶部状态栏 - 时间\\\", \\\"高中及以前\\\", \\\"=====经历=====\\\", \\\"陆浔\\\", \\\"纪津之\\\", \\\"宋今樾\\\", \\\"温宁津\\\", \\\"秦从徽\\\", \\\"裴确\\\", \\\"关系背景通用规则\\\", \\\"沈叙\\\", \\\"张续断\\\", \\\"应忱\\\", \\\"=====世界设定=====\\\", \\\"=====地点=====\\\", \\\"南沅一中\\\", \\\"南沅大学\\\", \\\"时代背景\\\", \\\"青梧华庭\\\", \\\"沅滨壹号\\\", \\\"情感数值定位\\\", \\\"底部状态栏 \\\", \\\"时空一致性\\\", \\\"现实逻辑与信息边界\\\", \\\"好感度行为规范\\\", \\\"人物与关系一致性\\\", \\\"=====行为规范=====\\\", \\\"情感变化规则\\\", \\\"南沅市\\\", \\\"言城市\\\", \\\"家庭背景\\\", \\\"NSFW行为规范\\\", \\\"高中及以前\\\", \\\"志愿填报\\\", \\\"高中毕业后\\\"]);\\nfunction parse(message) {\\n  let fence = null, status = false, collecting = false, current = [], found = [];\\n  for (const line of String(message || '').split(/\\\\r?\\\\n/)) {\\n    const mark = line.match(/^ {0,3}(`{3,}|~{3,})(.*)$/);\\n    if (mark) {\\n      if (!fence) fence = mark[1];\\n      else if (mark[1][0] === fence[0] && mark[1].length >= fence.length && /^[ \\\\t]*$/.test(mark[2])) fence = null;\\n      continue;\\n    }\\n    if (fence) continue;\\n    if (/^ {0,3}<xjw_status>[ \\\\t]*$/.test(line)) { status = true; continue; }\\n    if (status) { if (/^ {0,3}<\\\\/xjw_status>[ \\\\t]*$/.test(line)) status = false; continue; }\\n    if (/^ {0,3}<worldbook_switch>[ \\\\t]*$/.test(line)) { collecting = true; current = []; continue; }\\n    if (/^ {0,3}<\\\\/worldbook_switch>[ \\\\t]*$/.test(line)) { if (collecting) found = current; collecting = false; continue; }\\n    if (collecting && line.trim()) current.push(line.trim());\\n  }\\n  return [...new Set(found)];\\n}\\n\\nconst clone=x=>JSON.parse(JSON.stringify(x));\\nconst esc=s=>String(s).replace(/[&<>\\\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\\\"'\\\":'&#39;'}[c]));\\nconst protectedEntry=e=>PROTECTED.has(e.name)||/^\\\\s*<许今闻_(?:高中及以前|志愿填报|高中毕业后)(?:>|\\\\s)/.test(e.content||'');\\nfunction defaultHost(){\\n const fn=name=>{for(const w of [global,global.parent]){try{if(typeof w?.[name]==='function')return w[name].bind(w);if(typeof w?.TavernHelper?.[name]==='function')return w.TavernHelper[name].bind(w.TavernHelper);}catch{}}return null;};\\n const ctx=()=> (global.SillyTavern||global.parent?.SillyTavern)?.getContext?.()||{};\\n const h={events:global.tavern_events||global.parent?.tavern_events||ctx().eventTypes||{},\\n  getChatId:()=>ctx().getCurrentChatId?.()??ctx().chatId??'',getCharId:()=>fn('getCharAvatarPath')?.()||String(ctx().characterId??''),\\n  storageGet:k=>{try{return global.localStorage.getItem(k);}catch{return null;}},\\n  storageSet:(k,v)=>{try{global.localStorage.setItem(k,v);}catch{}},\\n  notify:s=>(global.toastr||global.parent?.toastr)?.info?.(esc(s),'开场白世界书')};\\n for(const n of ['getCharWorldbookNames','getChatWorldbookName','getChatMessages','getWorldbook','updateWorldbookWith','eventOn','eventMakeFirst','eventRemoveListener','getButtonEvent'])h[n]=fn(n);\\n return h;\\n}\\nfunction create(host=defaultHost()){\\n let stopped=false,started=false,revision=0,chain=Promise.resolve(),lastNotice='',lastError='';\\n let state={status:'waiting',names:[],enabled:[],opened:[],warnings:[]},stateScope='';\\n const listeners=[];\\n const scope=()=>JSON.stringify([String(host.getCharId?.()??''),String(host.getChatId?.()??'')]);\\n const notify=s=>{try{host.notify?.(s);}catch{}};\\n function readOpening(){\\n  const first=host.getChatMessages(0,{role:'all',include_swipes:true})?.find(x=>x.role!=='system');\\n  if(!first||first.role!=='assistant'||first.is_hidden)return null;\\n  const message=typeof first.message==='string'?first.message:first.swipes?.[first.swipe_id||0];\\n  if(typeof message!=='string')return null;\\n  // A half-edited tag must not silently clear all previously enabled entries.\\n  const starts=(message.match(/<worldbook_switch\\\\b/gi)||[]).length,ends=(message.match(/<\\\\/worldbook_switch\\\\s*>/gi)||[]).length;\\n  if(starts!==ends)throw Error('世界书切换标签未闭合，已保留现有开关');\\n  const names=parse(message);\\n  if(starts&&!names.length&&!/<worldbook_switch>\\\\s*<\\\\/worldbook_switch>/i.test(message))throw Error('世界书切换标签格式无法识别，已保留现有开关');\\n  return {names,all:[message,...(first.swipes||[]).filter(x=>typeof x==='string')],signature:JSON.stringify([first.swipe_id??0,message])};\\n }\\n function boundBooks(){const b=host.getCharWorldbookNames('current')||{};return [...new Set([b.primary,...(b.additional||[]),host.getChatWorldbookName?.('current')].filter(Boolean))];}\\n function getState(){return stateScope===scope()?clone(state):{status:'waiting',names:[],enabled:[],opened:[],warnings:[]};}\\n function refresh(options={}){\\n  const run=++revision,captured=scope();\\n  chain=chain.catch(()=>{}).then(async()=>{\\n   const current=()=>!stopped&&run===revision&&captured===scope();\\n   if(!current()||!String(host.getChatId?.()??''))return getState();\\n   try{\\n    const opening=readOpening();if(!opening)return getState();\\n    const valid=()=>current()&&readOpening()?.signature===opening.signature;\\n    const books=boundBooks(),catalog=[];\\n    for(const world of books){const entries=await host.getWorldbook(world);catalog.push({world,entries});if(!valid())return getState();}\\n    const requested=new Set(opening.names),warnings=[],opened=[],failures=[],enabled=[];\\n    const all=catalog.flatMap(b=>b.entries.map(e=>({...e,world:b.world})));\\n    const unique=new Map();\\n    for(const e of all){const a=unique.get(e.name)||[];a.push(e);unique.set(e.name,a);}\\n    for(const name of requested){const found=unique.get(name)||[];if(!found.length)warnings.push('找不到条目：'+name);else if(found.length>1)warnings.push('条目重名，未修改：'+name);else if(protectedEntry(found[0]))warnings.push('由常驻设定或人生经历脚本管理，未修改：'+name);}\\n    for(const {world,entries} of catalog){\\n     if(!valid())return getState();\\n     const storageKey='xjw-wb-switch-v3:'+JSON.stringify([host.getCharId?.()||'',world]);\\n     let record=null;try{record=JSON.parse(host.storageGet?.(storageKey)||'null');}catch{}\\n     const token=JSON.stringify([captured,opening.signature]);\\n     const previous=Array.isArray(record?.owned)?record.owned:[];\\n     const same=record?.token===token;\\n     const owned=new Map(previous.map(e=>[String(e.uid),e.name]));\\n     const targets=new Map();\\n     if(!same)for(const e of entries){\\n      if(protectedEntry(e)||unique.get(e.name)?.length!==1)continue;\\n      if(requested.has(e.name))targets.set(String(e.uid),{name:e.name,wanted:true});\\n      else if(owned.get(String(e.uid))===e.name)targets.set(String(e.uid),{name:e.name,wanted:false});\\n     }\\n     const needs=entries.some(e=>targets.has(String(e.uid))&&e.enabled!==targets.get(String(e.uid)).wanted);\\n     let saved=entries;\\n     let changes=[];\\n     if(needs){\\n      try{\\n       await host.updateWorldbookWith(world,live=>{\\n        changes=[];if(!valid())return live;\\n        return live.map(e=>{const t=targets.get(String(e.uid));if(!t||e.name!==t.name||protectedEntry(e)||live.filter(x=>x.name===e.name).length!==1||e.enabled===t.wanted)return e;\\n         changes.push({uid:e.uid,name:e.name,enabled:t.wanted});return {...e,enabled:t.wanted};});\\n       },{render:'immediate'});\\n       saved=await host.getWorldbook(world);\\n       for(const c of changes){if(saved.find(e=>String(e.uid)===String(c.uid))?.enabled!==c.enabled)failures.push('保存失败：'+c.name);else if(c.enabled)opened.push(c.name);}\\n      }catch(error){failures.push('世界书保存失败：'+world+'；'+String(error.message||error));}\\n     }\\n     if(!same){\\n      for(const c of changes){\\n       if(saved.find(e=>String(e.uid)===String(c.uid)&&e.name===c.name)?.enabled!==c.enabled)continue;\\n       if(c.enabled)owned.set(String(c.uid),c.name);else owned.delete(String(c.uid));\\n      }\\n      const retained=[...owned].filter(([uid,name])=>saved.some(e=>String(e.uid)===uid&&e.name===name&&e.enabled));\\n      host.storageSet?.(storageKey,JSON.stringify({token:failures.length?null:token,owned:retained.map(([uid,name])=>({uid,name}))}));\\n     }\\n     for(const e of saved)if(requested.has(e.name)&&e.enabled===true&&!protectedEntry(e)&&unique.get(e.name)?.length===1)enabled.push({world,uid:e.uid,name:e.name});\\n    }\\n    if(!valid())return getState();\\n    stateScope=captured;state={status:failures.length?'error':'ready',names:opening.names,enabled,opened:[...new Set(opened)],warnings:[...warnings,...failures]};\\n    const signature=JSON.stringify([captured,opening.signature,state.warnings]);\\n    if(!options.silent&&(signature!==lastNotice||opened.length)){\\n     notify(opened.length?'新增开启：'+state.opened.join('、'):'本次切换没有新增开启的世界书条目');\\n     if(state.warnings.length)notify(state.warnings.join('；'));lastNotice=signature;\\n    }\\n    lastError='';\\n   }catch(error){const message=String(error.message||error);if(current()){stateScope=captured;state={status:'error',names:[],enabled:[],opened:[],warnings:[message]};if(lastError!==captured+message){notify(message);lastError=captured+message;}}}\\n   return getState();\\n  });return chain;\\n }\\n function listen(event,callback,first=false){if(!event)return;const cb=(...args)=>{try{return Promise.resolve(callback(...args)).catch(e=>notify(String(e.message||e)));}catch(e){notify(String(e.message||e));}};const handle=(first&&host.eventMakeFirst||host.eventOn)(event,cb);listeners.push({event,cb,handle});}\\n function stop(){stopped=true;revision++;for(const l of listeners.splice(0)){try{if(l.handle?.stop)l.handle.stop();else host.eventRemoveListener?.(l.event,l.cb);}catch{}}}\\n function start(){if(started||stopped)return Promise.resolve(getState());\\n  for(const n of ['getChatMessages','getCharWorldbookNames','getWorldbook','updateWorldbookWith','eventOn'])if(!host[n]){notify('缺少酒馆助手接口：'+n);return Promise.resolve(getState());}\\n  started=true;const ev=host.events||{};\\n  listen(ev.CHAT_CHANGED,()=>refresh());\\n  for(const event of new Set([ev.MESSAGE_SWIPED,ev.MESSAGE_UPDATED,ev.MESSAGE_DELETED,ev.CHARACTER_FIRST_MESSAGE_SELECTED,ev.CHARACTER_MESSAGE_RENDERED].filter(Boolean)))listen(event,()=>refresh());\\n  // Recheck before worldbook loading, including catalogue/direct-navigation paths.\\n  listen(ev.GENERATION_AFTER_COMMANDS,(type,options,dryRun)=>dryRun?undefined:refresh({silent:type==='quiet'||type==='impersonate'}),true);\\n  if(host.getButtonEvent){listen(host.getButtonEvent('查看额外条目'),async()=>{await refresh({silent:true});const s=getState();notify(s.status==='error'?s.warnings.join('；'):s.enabled.length?'当前开场白已开启条目：'+s.enabled.map(e=>e.name).join('、'):'当前开场白没有已开启的额外条目');});}\\n  return refresh();\\n }\\n return {start,stop,refresh,getState};\\n}\\nglobal.XJW_WORLDBOOK_SWITCH_CREATE=create;\\nif(global.__XJW_WORLDBOOK_SWITCH_TEST__)return;\\nglobal.XJW_WORLDBOOK_SWITCH_API?.stop?.();\\nconst api=create();global.XJW_WORLDBOOK_SWITCH_API=api;api.start();\\nglobal.addEventListener('pagehide',api.stop,{once:true});\\n})(typeof window==='undefined'?globalThis:window);\\n\",\"info\":\"\",\"button\":{\"enabled\":false,\"buttons\":[]},\"data\":{},\"export_with\":{\"data\":false,\"button\":false}},{\"type\":\"script\",\"enabled\":true,\"name\":\"南沅｜校园手册\",\"id\":\"a11d4440-1902-4620-bbeb-d7c1dc1807c9\",\"content\":\"(async ()=>{'use strict';\\nconst S=window,W=S.parent,D=W.document,NS='ny_campus_v1';\\nfor(let i=0;i<100&&!D.body;i++)await new Promise(r=>setTimeout(r,100));\\nif(!D.body)throw Error('校园手册：酒馆页面尚未就绪');\\nconst direct={\\n getVariables:typeof getVariables==='function'?getVariables:null,\\n insertOrAssignVariables:typeof insertOrAssignVariables==='function'?insertOrAssignVariables:null,\\n updateVariablesWith:typeof updateVariablesWith==='function'?updateVariablesWith:null,\\n getChatMessages:typeof getChatMessages==='function'?getChatMessages:null,\\n generateRaw:typeof generateRaw==='function'?generateRaw:null,\\n injectPrompts:typeof injectPrompts==='function'?injectPrompts:null,\\n stopGenerationById:typeof stopGenerationById==='function'?stopGenerationById:null,\\n getCharWorldbookNames:typeof getCharWorldbookNames==='function'?getCharWorldbookNames:null,\\n getWorldbook:typeof getWorldbook==='function'?getWorldbook:null,\\n getScriptId:typeof getScriptId==='function'?getScriptId:null,\\n getAllEnabledScriptButtons:typeof getAllEnabledScriptButtons==='function'?getAllEnabledScriptButtons:null,\\n eventRemoveListener:typeof eventRemoveListener==='function'?eventRemoveListener:null,\\n getButtonEvent:typeof getButtonEvent==='function'?getButtonEvent:null,\\n eventOn:typeof eventOn==='function'?eventOn:null\\n};\\nconst fn=n=>{if(direct[n])return direct[n].bind(S);for(const o of [S,S.TavernHelper,W,W.TavernHelper])if(typeof o?.[n]==='function')return o[n].bind(o);};\\nconst ctx=()=>W.SillyTavern?.getContext?.()||{};\\nconst ap={get:fn('getVariables'),save:fn('insertOrAssignVariables'),update:fn('updateVariablesWith'),msgs:fn('getChatMessages'),gen:fn('generateRaw'),inject:fn('injectPrompts'),stop:fn('stopGenerationById')};\\nconst esc=s=>String(s??'').replace(/[&<>\\\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\\\"'\\\":'&#39;'}[c]));\\nconst clone=x=>JSON.parse(JSON.stringify(x));\\nconst text=(x,n=300)=>String(x??'').trim().slice(0,n);\\nconst uid=()=>typeof crypto?.randomUUID==='function'?crypto.randomUUID():Date.now().toString(36)+Math.random().toString(36).slice(2,10);\\nconst hash=s=>{let h=2166136261;for(const c of String(s)){h^=c.charCodeAt(0);h=Math.imul(h,16777619);}return (h>>>0).toString(16);};\\nconst day=d=>{if(!/^\\\\d{4}-\\\\d{2}-\\\\d{2}$/.test(d||''))return false;const x=new Date(d+'T12:00:00Z');return !isNaN(x)&&x.toISOString().slice(0,10)===d;};\\nconst minute=t=>/^([01]\\\\d|2[0-3]):[0-5]\\\\d$/.test(t||'')?+t.slice(0,2)*60 + +t.slice(3):NaN;\\nconst dow=d=>day(d)?new Date(d+'T12:00:00Z').getUTCDay():-1;\\nconst shift=(d,n)=>{const x=new Date(d+'T12:00:00Z');x.setUTCDate(x.getUTCDate()+n);return x.toISOString().slice(0,10);};\\nconst clean=s=>String(s||'').replace(/<(script|style|worldbook_switch|xjw_status)\\\\b[^>]*>[\\\\s\\\\S]*?<\\\\/\\\\1>/gi,'').replace(/<[^>]+>/g,' ').replace(/```[\\\\s\\\\S]*?```/g,'').trim();\\nfunction clock(messages){\\n const pattern=/[\\\\[【]\\\\s*(\\\\d{4})\\\\s*[-/年.]\\\\s*(\\\\d{1,2})\\\\s*[-/月.]\\\\s*(\\\\d{1,2})\\\\s*日?\\\\s*[|｜]\\\\s*(\\\\d{1,2})\\\\s*[:：]\\\\s*(\\\\d{2})\\\\s*(?=[|｜\\\\]】])/g;\\n for(let i=messages.length-1;i>=0;i--){\\n  const row=messages[i];if(row.role==='system'||row.is_system)continue;\\n  const raw=String(row.message??row.mes??'').replace(/[０-９]/g,ch=>String(ch.charCodeAt(0)-65296));\\n  pattern.lastIndex=0;let m;\\n  while((m=pattern.exec(raw))){const date=`${m[1]}-${m[2].padStart(2,'0')}-${m[3].padStart(2,'0')}`,time=`${m[4].padStart(2,'0')}:${m[5]}`;\\n   if(day(date)&&Number.isFinite(minute(time)))return {date,time,source:'剧情状态栏'};\\n  }\\n }return null;\\n}\\nfunction slots(input){if(!Array.isArray(input)||input.length>120)throw Error('课表格式错误或课程过多');const a=input.map(s=>{if(!Number.isInteger(+s.day)||+s.day<0||+s.day>6||!Number.isFinite(minute(s.start))||!Number.isFinite(minute(s.end))||minute(s.end)<=minute(s.start)||!text(s.subject,40))throw Error('课程的星期、时间或科目无效');return {id:text(s.id)||uid(),day:+s.day,start:s.start,end:s.end,subject:text(s.subject,40)};}).sort((a,b)=>a.day-b.day||minute(a.start)-minute(b.start));for(let i=1;i<a.length;i++)if(a[i].day===a[i-1].day&&minute(a[i].start)<minute(a[i-1].end))throw Error('同一天的课程时间重叠，请修改');return a;}\\nfunction event(v){const status=['confirmed','pending','cancelled'].includes(v.status)?v.status:'pending';const date=day(v.date)?v.date:'';if(status==='confirmed'&&!date)throw Error('已确定的活动需要日期');if(v.start&&!Number.isFinite(minute(v.start))||v.end&&!Number.isFinite(minute(v.end)))throw Error('活动时间格式错误');if(v.start&&v.end&&minute(v.end)<=minute(v.start))throw Error('活动结束时间应晚于开始时间');const title=text(v.title,80);if(!title)throw Error('请填写活动名称');return {id:text(v.id)||uid(),title,date,start:v.start||'',end:v.end||'',status,note:text(v.note,500),replace:!!v.replace,source:text(v.source,40)||'手动',locked:!!v.locked};}\\nfunction conflict(a,b){if(!a.date||a.date!==b.date||a.status!=='confirmed'||b.status!=='confirmed')return false;return !a.start||!a.end||!b.start||!b.end||minute(a.start)<minute(b.end)&&minute(b.start)<minute(a.end);}\\nfunction activeTerm(st,c){return c?st.terms.find(t=>t.start<=c.date&&t.end>=c.date):null;}\\nfunction lessons(t,c,who='main'){if(!t||!c)return [];const all=(who==='player'?t.playerSlots:t.slots)||[];const events=t.events.filter(e=>e.date===c.date&&e.status==='confirmed'&&e.replace);return all.filter(s=>s.day===dow(c.date)).map(s=>({...s,override:events.find(e=>!e.start||!e.end||minute(s.start)<minute(e.end)&&minute(e.start)<minute(s.end))}));}\\nfunction promptFor(t,c){if(!t||!c)return '';const e=t.events.filter(e=>e.status==='confirmed'&&e.date>=c.date&&e.date<=shift(c.date,7));return `[校园安排·事实约束]\\\\n当前剧情时间 ${c.date} ${c.time}，星期${'日一二三四五六'[dow(c.date)]}。学期 ${t.start} 至 ${t.end}，${t.school} ${t.className}；此课表只适用于${t.person}，不得默认玩家同班。\\\\n整周固定课表(星期0=日)：${JSON.stringify(t.slots.map(({day,start,end,subject})=>({day,start,end,subject})))}\\\\n今日：${JSON.stringify(lessons(t,c).map(s=>({start:s.start,end:s.end,subject:s.subject,override:s.override?.title})))}\\\\n未来七日已确认活动：${JSON.stringify(e)}\\\\n${t.playerName?'玩家课表（仅适用于'+t.playerName+'，与主角色分别核对）：'+JSON.stringify((t.playerSlots||[]).map(({day,start,end,subject})=>({day,start,end,subject}))):'玩家班级未知，不替玩家指定课程。'}\\\\n任课老师（固定名单，不得擅自换名）：${JSON.stringify(teacherRoster(t))}。温澜为裴确的母亲，英语教师，温和细致。教师教学能力均强，大多随和，严厉也不羞辱贬低学生。分班后默认固定带班，临时代课不更换原老师。未指定课程地点，按课程性质与已有剧情安排，体育课不得默认在教室。自习与活动未指定任课老师，不凭空绑定。\\\\n叙述校园上课时必须按对应日期星期和时间查课表，不反复默认数学课；无课时是课间/休息，不强行上课。replace=true的活动覆盖同时间课程。已确定的请假、放假、停课、网课、调课及用户明确更正优先，不能为了课表推翻剧情。不得强行推进时间或替玩家做决定。日期超出本学期或进入成年/工作线时此课表失效；未安排的活动不得当作已发生。保持现有状态栏时间格式，不输出此提示。`;} \\nfunction responseText(raw){if(typeof raw==='string')return raw;if(raw==null)return '';if(raw?.error)throw Error('接口错误：'+(raw.error.message||JSON.stringify(raw.error)));if(Array.isArray(raw))return raw.map(x=>typeof x==='string'?x:x?.text||'').join('\\\\n');if(raw.posts||raw.slots||raw.week||raw.events||raw.comments||raw.ok!==undefined)return JSON.stringify(raw);return responseText(raw.text??raw.content??raw.message?.content??raw.choices?.[0]?.message?.content??raw.choices?.[0]?.text??raw.output_text??'');}\\nfunction parseJSON(raw){const original=responseText(raw);if(!original.trim())throw Error('接口返回为空，请在设置中查看生成诊断');const s=original.replace(/^\\\\uFEFF/,'').replace(/<(think|thinking|reasoning)\\\\b[^>]*>[\\\\s\\\\S]*?<\\\\/\\\\1>/gi,'').trim();try{return JSON.parse(s);}catch{}for(let i=0;i<s.length;i++){if(s[i]!=='{'&&s[i]!=='[')continue;const stack=[];let quoted=false,escaped=false;for(let j=i;j<s.length;j++){const c=s[j];if(quoted){if(escaped)escaped=false;else if(c==='\\\\\\\\')escaped=true;else if(c==='\\\"')quoted=false;continue;}if(c==='\\\"'){quoted=true;continue;}if(c==='{'||c==='[')stack.push(c);else if(c==='}'||c===']'){if(stack.pop()!==(c==='}'?'{':'['))break;if(!stack.length){try{return JSON.parse(s.slice(i,j+1));}catch{break;}}}}}throw Error('返回内容不是完整 JSON，已保留诊断；原有数据未覆盖');}\\nfunction expandSchedule(r){\\n if(!Array.isArray(r.slots)&&Array.isArray(r.week)){\\n  const expand=(week,periods)=>{if(!Array.isArray(periods)||!periods.length)throw Error('缺少作息时间段');return week.flatMap(row=>{if(!Number.isInteger(row.day)||!Array.isArray(row.subjects)||row.subjects.length!==periods.length)throw Error('每天科目数量与作息节数不一致');return row.subjects.flatMap((subject,i)=>subject===null||subject===''?[]:[{day:row.day,start:periods[i][0],end:periods[i][1],subject}]);});};\\n  r.slots=expand(r.week,r.periods);r.playerSlots=Array.isArray(r.playerWeek)&&r.playerWeek.length?expand(r.playerWeek,r.playerPeriods||r.periods):[];\\n }return r;\\n}\\nfunction validResult(task,r){if(task==='term'&&r)r=expandSchedule(r);const key={term:'slots',forum:'posts',extract:'events',reply:'comments'}[task];if(!r||typeof r!=='object'||Array.isArray(r)||key&&!Array.isArray(r[key])||task==='test'&&r.ok!==true)throw Error('返回内容缺少'+(key||'ok')+'字段，请查看生成诊断');return r;}\\n\\nif(S.__NY_CAMPUS_TEST__){S.__NY_CAMPUS_CORE__={day,minute,dow,shift,clock,slots,event,conflict,activeTerm,lessons,promptFor,parseJSON,responseText,validResult,expandSchedule};return;}\\nif(!ap.get||(!ap.save&&!ap.update)||!ap.gen){\\n const missing=[['getVariables',ap.get],['变量写入接口',ap.save||ap.update],['generateRaw',ap.gen]].filter(([,f])=>!f).map(([n])=>n);\\n const warning=D.createElement('button');warning.textContent='校园手册 · 接口异常';warning.title='缺少：'+missing.join('、');warning.style.cssText='position:fixed;right:12px;bottom:105px;z-index:2147483647;padding:9px 14px;border:2px solid #a44;border-radius:12px;background:white;color:#a44';\\n warning.onclick=()=>W.alert?.('校园手册无法启动，酒馆助手未提供：'+missing.join('、'));\\n D.body.append(warning);S.addEventListener('pagehide',()=>warning.remove(),{once:true});return;\\n}\\ntry{W.__nyCampusCleanup?.();}catch(e){console.warn('校园手册旧实例清理失败',e);}\\nD.querySelectorAll('#ny-campus-host,[data-ny-campus-launch]').forEach(e=>e.remove());\\nconst localKey='ny-campus-device-v1';let pref={mode:'tavern',url:'',key:'',model:'',source:'openai',scale:1,figureHeight:100,figureUrl:'',auto:true,entryMode:'figure'};try{Object.assign(pref,JSON.parse(W.localStorage.getItem(localKey)||'{}'));}catch{}\\nif(pref.figureRevision!==3){pref.figureHeight=100;pref.figureUrl='';pref.figureRevision=3;}\\nconst localSave=()=>{try{W.localStorage.setItem(localKey,JSON.stringify(pref));}catch{notify('浏览器无法保存设置，本次刷新后需重新填写。');}};\\nlet state,identity='',tab='课表',week=false,weekend=false,dayOffset=0,weekDay=1,selectedTerm='',manual=null,opened=false,busy=false,genId='',destroyed=false,uninject=null,mainBusy=false,extractTimer,toastTimer,pollTimer,revision=0,detail=null;\\nlet mainSince=0,lastFailure=null,requestCancel=null;\\nconst disposers=[];\\nconst chatKey=()=>{const c=ctx();const id=c.chatId||c.getCurrentChatId?.();return id?String(c.characterId??'group')+':'+id:'';};\\nconst messages=()=>{try{return (ap.msgs?.(ctx().chat?.length?`$